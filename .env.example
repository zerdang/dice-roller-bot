# Safe local example. Never commit the real client secret.
HOST=0.0.0.0
PORT=8080
COMPANION_DB=databases/companion.db
COMPANION_ASSETS=databases/companion-assets
COMPANION_PUBLIC_URL=http://localhost:8080
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_secret_from_the_discord_developer_portal
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
COMPANION_ALLOW_LEGACY_BEARER=false
